# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY=""

# EMAIL NOTIFICATIONS (RESEND)
# Sign up at https://resend.com for a free API key to send live email alerts
RESEND_API_KEY=""
EMAIL_FROM="Inventory Hub <onboarding@resend.dev>"

# NOTIFICATION RECIPIENT EMAIL
# The inbox where purchase order and low-stock alerts will be delivered
NOTIFICATION_RECIPIENT_EMAIL="procurement@company.com"

# ZAPIER WEBHOOK URL (OPTIONAL ALTERNATIVE)
# Production Zapier Catch Hook URL for workflow automation
ZAPIER_WEBHOOK_URL=""

